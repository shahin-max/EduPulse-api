# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
# Comma separated list of allowed browser origins (the Next.js site), e.g. the Netlify site and the
# custom domain: https://edupulse.netlify.app,https://www.edupulseacademy.in
CORS_ORIGINS=http://localhost:3000
# Reverse proxies in front of the API (Railway: 1). Defaults to 1 when NODE_ENV=production, else 0.
# Needed so rate limits and audit logs see each visitor's IP instead of the proxy's.
TRUST_PROXY=

# MySQL 8. Special characters in the password must be URL-encoded.
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/edupulse_lms

# Use long random strings (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`).
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=10

# Used only by `npm run db:seed` to create the first admin account.
SEED_ADMIN_EMAIL=admin@edupulse.local
SEED_ADMIN_PASSWORD=ChangeMe@123

# Email (password reset and email verification links). SMTP URL such as
# smtp://USER:PASSWORD@smtp.example.com:587 (STARTTLS) or smtps://...:465. When empty, emails are
# only logged (with the link outside production).
SMTP_URL=
MAIL_FROM=EduPulse Academy <no-reply@example.com>
# Public website address, used for links in emails. Defaults to the first CORS origin.
APP_WEB_URL=http://localhost:3000

# No SMS provider yet: when true (and NODE_ENV is not production), password reset and
# verification endpoints return the token as `devToken` so you can test the flow locally.
EXPOSE_DEV_TOKENS=false
# Where uploaded files are stored on disk. On Railway the container disk is wiped on every deploy:
# attach a Volume (e.g. mounted at /data) and set UPLOAD_DIR=/data/uploads, or uploads are lost.
UPLOAD_DIR=./uploads
