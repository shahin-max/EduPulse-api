# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
# Comma separated list of allowed browser origins (the Next.js site), e.g. the Netlify site and the
# custom domain: https://edupulse.netlify.app,https://www.edupulseacademy.in
CORS_ORIGINS=http://localhost:3000
# Reverse proxies in front of the API (Railway: 1). Defaults to 1 when NODE_ENV=production, else 0.
# Needed so rate limits and audit logs see each visitor's IP instead of the proxy's.
TRUST_PROXY=
# API reference at /docs: on in development, off in production unless API_DOCS=true.
API_DOCS=

# MySQL 8. Special characters in the password must be URL-encoded.
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/edupulse_lms

# Use long random strings (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`).
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=10

# Used only by `npm run db:seed` to create the first admin account.
SEED_ADMIN_EMAIL=admin@edupulse.local
SEED_ADMIN_PASSWORD=ChangeMe@123

# Email (password reset and email verification links). SMTP URL such as
# smtp://USER:PASSWORD@smtp.example.com:587 (STARTTLS) or smtps://...:465. When empty, emails are
# only logged (with the link outside production).
SMTP_URL=
MAIL_FROM=EduPulse Academy <no-reply@edupulseindia.com>

# Public website address, used for links in emails. Defaults to the first CORS origin.
APP_WEB_URL=http://localhost:3000

# No SMS provider yet: when true (and NODE_ENV is not production), password reset and
# verification endpoints return the token as `devToken` so you can test the flow locally.
EXPOSE_DEV_TOKENS=false
# Where uploaded files are stored on disk. On Railway the container disk is wiped on every deploy:
# attach a Volume (e.g. mounted at /data) and set UPLOAD_DIR=/data/uploads, or uploads are lost.
UPLOAD_DIR=./uploads

# Cloudinary (recommended in production): set all three to store uploads on Cloudinary instead of
# UPLOAD_DIR, and to enable profile photos. Course files and submissions are private (served only
# through the API); profile photos are public. Files already on disk keep working.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Top-level Cloudinary folder, so several environments can share one account.
CLOUDINARY_FOLDER=edupulse

# Staged launch: "admin" opens only the admin portal (faculty and students see "opening soon").
# Unset or "all" opens every portal. Restart the API after changing it.
PORTALS_OPEN=all

# Background jobs (every minute, on one instance at a time): scheduled announcements and class
# reminders. On by default; "false" falls back to running them when notifications are read.
JOBS_ENABLED=true

# SMS for password reset and mobile verification links (mobile-only accounts). Empty = logged only.
# twilio: TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM (number or Messaging Service SID "MG...").
# msg91 (India, DLT): MSG91_AUTH_KEY and one approved Flow template per message, each with a ##link## variable.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_PASSWORD_RESET=
MSG91_TEMPLATE_MOBILE_VERIFY=

# Email copies of fee, marks, results, new work and announcement notifications (needs SMTP_URL).
EMAIL_NOTIFICATIONS=true
