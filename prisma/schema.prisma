model payments {
  id                 BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  invoice_id         BigInt            @db.UnsignedBigInt
  amount             Decimal           @db.Decimal(12, 2)
  currency           String            @default("INR") @db.Char(3)
  method             payments_method
  provider           String?           @db.VarChar(40)
  external_reference String?           @db.VarChar(120)
  idempotency_key    String            @unique(map: "uq_payment_idempotency") @db.VarChar(100)
