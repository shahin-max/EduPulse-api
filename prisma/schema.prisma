  @@unique([provider, external_reference], map: "uq_payment_provider_ref")
  @@index([recorded_by], map: "fk_payment_recorder")
  @@index([invoice_id, status], map: "idx_payments_invoice")
  @@index([external_reference], map: "idx_payments_ref")
}

