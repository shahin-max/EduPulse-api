// EduPulse Academy LMS - mirrors the hand-designed `edupulse_lms` MySQL schema.
// Table and column names are the database's own (snake_case). CHECK constraints and
// ON UPDATE timestamps live in prisma/migrations/0_init/migration.sql; Prisma cannot
// express them, so do not regenerate that migration from this file.
// The connection URL lives in prisma.config.ts (Prisma 7 style).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

model admission_enquiries {
  id                   BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  student_name         String                     @db.VarChar(160)
  email                String?                    @db.VarChar(254)
  mobile               String                     @db.VarChar(20)
  interested_course_id BigInt?                    @db.UnsignedBigInt
  message              String?                    @db.Text
  source               String?                    @db.VarChar(64)
  status               admission_enquiries_status @default(NEW)
  assigned_to          BigInt?                    @db.UnsignedBigInt
  created_at           DateTime                   @default(now())
  updated_at           DateTime                   @default(now())
  users                users?                     @relation(fields: [assigned_to], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_enquiries_assignee")
  courses              courses?                   @relation(fields: [interested_course_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_enquiries_course")

  @@index([assigned_to], map: "fk_enquiries_assignee")
  @@index([interested_course_id], map: "idx_enquiries_course")
  @@index([status, created_at], map: "idx_enquiries_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model announcements {
  id         BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  title      String                 @db.VarChar(200)
  body       String                 @db.Text
  audience   announcements_audience @default(ALL)
  batch_id   BigInt?                @db.UnsignedBigInt
  status     announcements_status   @default(DRAFT)
  publish_at DateTime?
  created_by BigInt?                @db.UnsignedBigInt
  created_at DateTime               @default(now())
  batches    batches?               @relation(fields: [batch_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_announcement_batch")
  users      users?                 @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_announcement_creator")

  @@index([batch_id], map: "fk_announcement_batch")
  @@index([created_by], map: "fk_announcement_creator")
  @@index([status, publish_at], map: "idx_announcements_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model assignment_submissions {
  batch_id      BigInt       @db.UnsignedBigInt
  id            BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  assignment_id BigInt       @db.UnsignedBigInt
  enrollment_id BigInt       @db.UnsignedBigInt
  asset_id      BigInt?      @db.UnsignedBigInt
  response_text String?      @db.Text
  submitted_at  DateTime     @default(now())
  marks_awarded Decimal?     @db.Decimal(8, 2)
  feedback      String?      @db.Text
  reviewed_by   BigInt?      @db.UnsignedBigInt
  reviewed_at   DateTime?
  file_assets   file_assets? @relation(fields: [asset_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_submission_asset")
  assignments   assignments  @relation(fields: [assignment_id, batch_id], references: [id, batch_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_submission_assignment")
  enrollments   enrollments  @relation(fields: [enrollment_id, batch_id], references: [id, batch_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_submission_enrollment")
  users         users?       @relation(fields: [reviewed_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_submission_reviewer")

  @@unique([assignment_id, enrollment_id], map: "uq_submission")
  @@index([asset_id], map: "fk_submission_asset")
  @@index([assignment_id, batch_id], map: "fk_submission_assignment")
  @@index([enrollment_id, batch_id], map: "fk_submission_enrollment")
  @@index([reviewed_by], map: "fk_submission_reviewer")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model assignments {
  id                     BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  batch_id               BigInt                   @db.UnsignedBigInt
  subject_id             BigInt?                  @db.UnsignedBigInt
  title                  String                   @db.VarChar(200)
  instructions           String?                  @db.Text
  attachment_asset_id    BigInt?                  @db.UnsignedBigInt
  due_at                 DateTime?
  max_marks              Decimal?                 @db.Decimal(8, 2)
  status                 assignments_status       @default(DRAFT)
  created_by             BigInt?                  @db.UnsignedBigInt
  created_at             DateTime                 @default(now())
  assignment_submissions assignment_submissions[]
  file_assets            file_assets?             @relation(fields: [attachment_asset_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_assignment_asset")
  batches                batches                  @relation(fields: [batch_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_assignment_batch")
  users                  users?                   @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_assignment_creator")
  subjects               subjects?                @relation(fields: [subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_assignment_subject")

  @@unique([id, batch_id], map: "uq_assignment_batch")
  @@index([attachment_asset_id], map: "fk_assignment_asset")
  @@index([created_by], map: "fk_assignment_creator")
  @@index([subject_id], map: "fk_assignment_subject")
  @@index([batch_id, due_at], map: "idx_assignment_batch")
}

model attempt_answers {
  exam_id              BigInt            @db.UnsignedBigInt
  display_order        Int               @db.UnsignedInt
  is_marked_for_review Boolean           @default(false)
  attempt_id           BigInt            @db.UnsignedBigInt
  question_id          BigInt            @db.UnsignedBigInt
  selected_option_id   BigInt?           @db.UnsignedBigInt
  is_correct           Boolean?
  marks_awarded        Decimal?          @db.Decimal(8, 2)
  answered_at          DateTime?
  exam_attempts        exam_attempts     @relation(fields: [attempt_id, exam_id], references: [id, exam_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_answer_attempt")
  question_options     question_options? @relation(fields: [selected_option_id, question_id], references: [id, question_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_answer_option")
  exam_questions       exam_questions    @relation(fields: [exam_id, question_id], references: [exam_id, question_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_answer_question")

  @@id([attempt_id, question_id])
  @@index([attempt_id, exam_id], map: "fk_answer_attempt")
  @@index([selected_option_id, question_id], map: "fk_answer_option")
  @@index([exam_id, question_id], map: "fk_answer_question")
}

model audit_logs {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  actor_user_id BigInt?  @db.UnsignedBigInt
  action        String   @db.VarChar(100)
  entity_type   String   @db.VarChar(80)
  entity_id     String?  @db.VarChar(80)
