  ip_address    String?  @db.VarChar(45)
  created_at    DateTime @default(now())
  users         users?   @relation(fields: [actor_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_audit_actor")

  @@index([actor_user_id, created_at], map: "idx_audit_actor")
  @@index([entity_type, entity_id], map: "idx_audit_entity")
}

model auth_sessions {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  token_hash String    @unique(map: "uq_auth_sessions_hash") @db.Char(64)
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime  @default(now())
  users      users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_auth_sessions_user")

  @@index([expires_at], map: "idx_auth_sessions_exp")
  @@index([user_id], map: "idx_auth_sessions_user")
}

model auth_tokens {
  id         BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt              @db.UnsignedBigInt
  purpose    auth_tokens_purpose
  token_hash String              @unique(map: "uq_auth_tokens_hash") @db.Char(64)
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime            @default(now())
  users      users               @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_auth_tokens_user")

  @@index([user_id, purpose], map: "idx_auth_tokens_user")
}

model batch_faculty {
  batch_id         BigInt           @db.UnsignedBigInt
  faculty_user_id  BigInt           @db.UnsignedBigInt
  subject_id       BigInt           @db.UnsignedBigInt
  assigned_at      DateTime         @default(now())
  batches          batches          @relation(fields: [batch_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_batch_faculty_batch")
  faculty_profiles faculty_profiles @relation(fields: [faculty_user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_batch_faculty_faculty")
  subjects         subjects         @relation(fields: [subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_batch_faculty_subject")

  @@id([batch_id, faculty_user_id, subject_id])
  @@index([subject_id], map: "fk_batch_faculty_subject")
  @@index([faculty_user_id], map: "idx_batch_faculty_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
