/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model exam_attempts {
  batch_id         BigInt               @db.UnsignedBigInt
  id               BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  exam_id          BigInt               @db.UnsignedBigInt
  enrollment_id    BigInt               @db.UnsignedBigInt
  attempt_number   Int                  @db.UnsignedSmallInt
  started_at       DateTime             @default(now())
  submitted_at     DateTime?
  expires_at       DateTime
  status           exam_attempts_status @default(IN_PROGRESS)
  correct_count    Int                  @default(0) @db.UnsignedInt
  wrong_count      Int                  @default(0) @db.UnsignedInt
  unanswered_count Int                  @default(0) @db.UnsignedInt
  score            Decimal?             @db.Decimal(10, 2)
  max_score        Decimal              @db.Decimal(10, 2)
  percentage       Decimal?             @db.Decimal(8, 2)
  graded_at        DateTime?
  attempt_answers  attempt_answers[]
  exam_batches     exam_batches         @relation(fields: [exam_id, batch_id], references: [exam_id, batch_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_attempt_batch")
  enrollments      enrollments          @relation(fields: [enrollment_id, batch_id], references: [id, batch_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_attempt_enrollment")
  exams            exams                @relation(fields: [exam_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_attempt_exam")

  @@unique([id, exam_id], map: "uq_attempt_exam")
  @@unique([exam_id, enrollment_id, attempt_number], map: "uq_exam_attempt")
  @@index([exam_id, batch_id], map: "fk_attempt_batch")
  @@index([enrollment_id, batch_id], map: "fk_attempt_enrollment")
  @@index([enrollment_id, submitted_at], map: "idx_attempt_enrollment")
  @@index([exam_id, status, score, submitted_at], map: "idx_attempt_exam_rank")
}

