model fee_invoices {
  id              BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  invoice_number  String              @unique(map: "uq_invoice_number") @db.VarChar(50)
  enrollment_id   BigInt              @db.UnsignedBigInt
  fee_plan_id     BigInt?             @db.UnsignedBigInt
  description     String?             @db.VarChar(255)
  gross_amount    Decimal             @db.Decimal(12, 2)
  /// GENERATED ALWAYS AS (gross_amount - discount_amount) STORED: computed by MySQL, never write it.
  amount_due      Decimal?            @db.Decimal(12, 2)
  discount_amount Decimal             @default(0.00) @db.Decimal(12, 2)
  due_date        DateTime?           @db.Date
  status          fee_invoices_status @default(DRAFT)
  issued_at       DateTime?
  created_at      DateTime            @default(now())
  enrollments     enrollments         @relation(fields: [enrollment_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_invoice_enrollment")
  fee_plans       fee_plans?          @relation(fields: [fee_plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_invoice_plan")
  payments        payments[]

  @@index([fee_plan_id], map: "fk_invoice_plan")
  @@index([enrollment_id, status], map: "idx_invoice_enrollment")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model fee_plans {
  id           BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  course_id    BigInt         @db.UnsignedBigInt
  batch_id     BigInt?        @db.UnsignedBigInt
  title        String         @db.VarChar(160)
  currency     String         @default("INR") @db.Char(3)
  amount       Decimal        @db.Decimal(12, 2)
  is_active    Boolean        @default(true)
  created_at   DateTime       @default(now())
  fee_invoices fee_invoices[]
  batches      batches?       @relation(fields: [batch_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_fee_plan_batch")
  courses      courses        @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_fee_plan_course")

  @@index([batch_id], map: "fk_fee_plan_batch")
  @@index([course_id, batch_id], map: "idx_fee_plans_course")
}

model file_assets {
  id                     BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
