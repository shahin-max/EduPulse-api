# Copy to .env.test. Used only by `npm run test:e2e`, which DELETES ALL ROWS in this database.
# The database name must end in _test; the suite refuses to run otherwise.
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/edupulse_lms_test
JWT_ACCESS_SECRET=e2e-access-secret-0123456789abcdefghijklmnop
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=e2e-refresh-secret-0123456789abcdefghijklmno
JWT_REFRESH_TTL=7d
# Low cost keeps the suite fast; never use this in production.
BCRYPT_ROUNDS=4
CORS_ORIGINS=http://localhost:3000
EXPOSE_DEV_TOKENS=true
UPLOAD_DIR=./uploads-test
